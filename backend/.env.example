# One Groq key powers the single vision request per photo.
# (GROQ_QWEN_API_KEY is still accepted as a fallback name.)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Spend protection for POST /evidence/analyze.
ANALYZE_RATE_PER_MINUTE=6
ANALYZE_GLOBAL_PER_HOUR=120
# Set to 1 only behind a proxy you control (Docker nginx / Cloudflare tunnel),
# so per-client limits use CF-Connecting-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=0

VERIPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
