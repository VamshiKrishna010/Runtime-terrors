# Public Convex deployment URL (read by Vite and by docker compose).
CONVEX_URL=https://your-development-deployment.convex.cloud

# Optional: compute description embeddings with ml_service instead of in the
# browser. Docker Compose sets this to /ml automatically.
# VITE_ML_SERVICE_URL=http://127.0.0.1:8001

# Optional: vision-analysis service. Defaults to the /api dev proxy; the
# GitHub Pages build skips vision analysis unless this is set.
# VITE_API_URL=https://your-analysis-host.example
